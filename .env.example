# Database (Supabase "Transaction pooler", port 6543)
DATABASE_URL=
SETUP_SECRET=

# Administrator account created by `npm run db:setup`
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# AI assistant and quiz builder (console.groq.com)
GROQ_API_KEY=

# Mail: Resend on your own domain is preferred; Gmail is the fallback
RESEND_API_KEY=
MAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# File storage: Supabase Storage (Project Settings → API). Empty = files stay in the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=files
