generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(100)
  login            String    @unique @db.VarChar(50)
  password         String    @db.Text
  role             String?   @default("student") @db.VarChar(20)
  status           String?   @default("active") @db.VarChar(20)
  failedLoginCount Int?      @default(0) @map("failed_login_count")
  lockoutUntil     DateTime? @map("lockout_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdModules   Module[]        @relation("ModuleCreator")
  updatedContent   ModuleContent[] @relation("ContentUpdater")
  progress         Progress[]
  userRoles        UserRole[]
  assignedRoles    UserRole[]      @relation("RoleAssigner")
  sessions         Session[]
  auditLogs        AuditLog[]      @relation("AuditActor")
  notifications    Notification[]

  @@index([login], name: "idx_np_users_login")
  @@index([role], name: "idx_np_users_role")
  @@index([status, deletedAt], name: "idx_np_users_status_deleted")
  @@index([createdAt(sort: Desc)], name: "idx_np_users_created_at")
  @@map("np_users")
}

model Module {
  id          Int       @id @default(autoincrement())
  orderNum    Int       @unique @map("order_num")
  title       String    @db.VarChar(200)
  description String?   @db.Text
  createdBy   Int?      @map("created_by")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  creator     User?           @relation("ModuleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  contents    ModuleContent[]
  progress    Progress[]

  @@index([orderNum], name: "idx_np_modules_order")
  @@index([createdBy], name: "idx_np_modules_created_by")
  @@index([deletedAt], name: "idx_np_modules_deleted_at")
  @@map("np_modules")
}

model ModuleContent {
  id        Int       @id @default(autoincrement())
  moduleId  Int       @map("module_id")
  stepType  String    @map("step_type") @db.VarChar(50)
  content   Json      @default("{}") @db.JsonB
  updatedBy Int?      @map("updated_by")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  updater   User?     @relation("ContentUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([moduleId, stepType])
  @@index([moduleId], name: "idx_np_module_content_mod")
  @@index([stepType], name: "idx_np_module_content_step")
  @@index([updatedBy], name: "idx_np_module_content_updated_by")
  @@map("np_module_content")
}

model Progress {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  moduleId       Int       @map("module_id")
  completedSteps Json?     @default("[]") @map("completed_steps") @db.JsonB
  stepResponses  Json      @default("{}") @map("step_responses") @db.JsonB
  totalScore     Int?      @default(0) @map("total_score")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId], name: "idx_np_progress_user_id")
  @@index([moduleId], name: "idx_np_progress_module_id")
  @@index([userId, moduleId], name: "idx_np_progress_user_mod")
  @@index([moduleId, updatedAt(sort: Desc)], name: "idx_np_progress_mod_updated")
  @@index([totalScore(sort: Desc)], name: "idx_np_progress_score")
  @@map("np_progress")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  systemType  String    @map("system_type") @db.VarChar(20)
  description String?   @db.VarChar(255)
  isDefault   Boolean?  @default(false) @map("is_default")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([systemType], name: "idx_np_roles_system_type")
  @@map("np_roles")
}

model Permission {
  id          Int       @id @default(autoincrement())
  action      String    @db.VarChar(50)
  resource    String    @db.VarChar(50)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(255)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@index([resource], name: "idx_np_permissions_resource")
  @@map("np_permissions")
}

model UserRole {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  roleId     Int       @map("role_id")
  assignedAt DateTime? @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy Int?      @map("assigned_by")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner   User?     @relation("RoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId], name: "idx_np_user_roles_role_id")
  @@index([userId], name: "idx_np_user_roles_user_id")
  @@map("np_user_roles")
}

model RolePermission {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  permissionId Int       @map("permission_id")
  assignedAt   DateTime? @default(now()) @map("assigned_at") @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId], name: "idx_np_role_permissions_role")
  @@index([permissionId], name: "idx_np_role_permissions_perm")
  @@map("np_role_permissions")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorId    Int?      @map("actor_id")
  action     String    @db.VarChar(50)
  entityName String    @map("entity_name") @db.VarChar(100)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  oldValues  Json?     @map("old_values") @db.JsonB
  newValues  Json?     @map("new_values") @db.JsonB
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  actor      User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId], name: "idx_np_audit_entity")
  @@index([actorId, createdAt(sort: Desc)], name: "idx_np_audit_actor")
  @@index([action, createdAt(sort: Desc)], name: "idx_np_audit_action_created")
  @@map("np_audit_logs")
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  deviceType String?   @map("device_type") @db.VarChar(50)
  isValid    Boolean?  @default(true) @map("is_valid")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isValid, expiresAt], name: "idx_np_sessions_active")
  @@index([tokenHash], name: "idx_np_sessions_token")
  @@map("np_sessions")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String?   @default("SYSTEM_ALERT") @db.VarChar(50)
  priority  String?   @default("MEDIUM") @db.VarChar(20)
  title     String    @db.VarChar(200)
  message   String    @db.Text
  data      Json?     @default("{}") @db.JsonB
  isRead    Boolean?  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, deletedAt, createdAt(sort: Desc)], name: "idx_np_notif_user_unread")
  @@map("np_notifications")
}
